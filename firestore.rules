rules_version = '2';

// COS330 Shared Study Tracker: Firestore Security Rules.
//
// Model (spec §20): Google Sign-In with an owner-managed allowlist.
// /allowedUsers/{lower-cased email} = { profile: 'kyle' | 'david' } lists the
// only two Google accounts that may read or write study data. The allowlist is
// managed ONLY by the owner (scripts/allow-user.mjs with Admin credentials or
// the Firebase Console). Browsers can never write it, and the email addresses
// live only in the database, never in this public repository.
//
// Because each account maps to one profile, people can only change their OWN
// progress, ticks and authored items; shared things (sessions, discussion
// status) are editable by both.
//
// Deny by default: anything not matched below is refused.
// Tested with the emulator in tests/rules/rules.test.mjs.

service cloud.firestore {
  match /databases/{database}/documents {

    // ------------------------------------------------------------ helpers
    function signedIn() { return request.auth != null; }

    function allowPath() {
      return /databases/$(database)/documents/allowedUsers/$(request.auth.token.email.lower());
    }

    function approved() {
      return signedIn()
        && request.auth.token.firebase.sign_in_provider == 'google.com'
        && request.auth.token.email_verified == true
        && exists(allowPath());
    }

    // The profile ('kyle' | 'david') this signed-in account belongs to.
    function myProfile() { return get(allowPath()).data.profile; }

    function okWs(ws) { return ws == 'cos330-2026' && approved(); }

    function profiles() { return ['kyle', 'david']; }
    function isProfile(p) { return p is string && p in profiles(); }

    // Keep in sync with data/seed-schedule.json topics (checked by tests).
    function topicIdList() {
      return ['ch01', 'ch02', 'ch03', 'ch04', 'ch05', 'ch06', 'ch07', 'ch08', 'ch09', 'ch10', 'ch11', 'ch13'];
    }
    function isTopicList(v) { return v is list && v.size() <= 12 && v.hasOnly(topicIdList()); }

    function str(v, max) { return v is string && v.size() <= max; }
    function nonEmpty(v, max) { return v is string && v.size() >= 1 && v.size() <= max; }

    function leap(y) { return y % 4 == 0 && (y % 100 != 0 || y % 400 == 0); }
    function validYMD(y, m, d) {
      return y >= 2020 && y <= 2100 && d >= 1 && (
        (m in [1, 3, 5, 7, 8, 10, 12] && d <= 31)
        || (m in [4, 6, 9, 11] && d <= 30)
        || (m == 2 && (d <= 28 || (d == 29 && leap(y)))));
    }
    // A real ISO calendar date "YYYY-MM-DD", not just a pattern match.
    function isDate(s) {
      return s is string && s.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && validYMD(int(s.split('-')[0]), int(s.split('-')[1]), int(s.split('-')[2]));
    }
    function isTime(t) { return t == null || (t is string && t.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$')); }
    function nullOrDate(v) { return v == null || isDate(v); }

    function stampedNow(d) { return d.updatedAt == request.time && d.updatedByUid == request.auth.uid; }

    // Timestamp fields that may only be null, unchanged, or set to "now".
    function tsOk(field) {
      let d = request.resource.data;
      return d[field] == null
        || d[field] == request.time
        || (resource != null && field in resource.data && d[field] == resource.data[field]);
    }

    // ------------------------------------------------------------ access control
    // An account may read ONLY its own allowlist entry (to learn its access + profile).
    match /allowedUsers/{email} {
      allow get: if signedIn() && request.auth.token.email != null
        && email == request.auth.token.email.lower();
      allow list, create, update, delete: if false;
    }

    match /workspaces/{ws} {
      // Workspace metadata (exam date, schema, source) is admin-managed only.
      allow get: if okWs(ws);
      allow list, create, update, delete: if false;

      // Canonical topics come from the owner-only seed import. Read-only here.
      match /topics/{topicId} {
        allow read: if okWs(ws);
        allow write: if false;
      }

      // ---------------------------------------------------------- progress
      // One doc per participant per topic: {profile}__{topicId}
      match /progress/{docId} {
        allow read: if okWs(ws);
        allow create, update: if okWs(ws) && validProgress(docId);
        allow delete: if false; // never delete historical progress
      }

      function validProgress(docId) {
        let d = request.resource.data;
        let keys = ['profileId', 'topicId', 'status', 'depth', 'notes', 'startedAt', 'completedAt', 'updatedAt', 'updatedByUid'];
        return d.keys().hasOnly(keys) && d.keys().hasAll(keys)
          && isProfile(d.profileId) && d.profileId == myProfile() // only your own progress
          && d.topicId in topicIdList()
          && docId == d.profileId + '__' + d.topicId
          && d.status in ['not_started', 'in_progress', 'completed', 'needs_practice', 'exam_ready']
          && d.depth in ['none', 'exposure', 'mv', 'must', 'beyond']
          && str(d.notes, 2000)
          && tsOk('startedAt') && tsOk('completedAt')
          && stampedNow(d)
          && (resource == null || (d.profileId == resource.data.profileId && d.topicId == resource.data.topicId));
      }

      // ---------------------------------------------------------- checklists
      // Ticked tasks / queue items / technical examples: {profile}__{itemId}
      match /checks/{docId} {
        allow read: if okWs(ws);
        allow create, update: if okWs(ws) && validCheck(docId);
        allow delete: if false;
      }

      function validCheck(docId) {
        let d = request.resource.data;
        let keys = ['profileId', 'itemId', 'done', 'updatedAt', 'updatedByUid'];
        return d.keys().hasOnly(keys) && d.keys().hasAll(keys)
          && isProfile(d.profileId) && d.profileId == myProfile() // only your own ticks
          && d.itemId is string && d.itemId.matches('^[a-z0-9][a-z0-9-]{0,118}$')
          && docId == d.profileId + '__' + d.itemId
          && d.done is bool
          && stampedNow(d);
      }

      // ---------------------------------------------------------- sessions
      match /sessions/{sessionId} {
        allow read: if okWs(ws);
        allow create: if okWs(ws) && validUserSession()
          && request.resource.data.createdAt == request.time
          && request.resource.data.createdBy == myProfile()
          && request.resource.data.status == 'planned';
        allow update: if okWs(ws) && (
          (resource.data.imported == true && validImportedSessionUpdate())
          || (resource.data.imported == false && validUserSession()
              && request.resource.data.createdAt == resource.data.createdAt
              && request.resource.data.createdBy == resource.data.createdBy));
        // Only sessions the two of you added can be deleted; imported ones can be cancelled.
        allow delete: if okWs(ws) && resource.data.imported == false;
      }

      // Imported sessions keep their provenance: only scheduling/status fields change.
      function validImportedSessionUpdate() {
        let d = request.resource.data;
        let r = resource.data;
        return d.diff(r).affectedKeys().hasOnly(['date', 'status', 'statusReason', 'userNotes', 'rescheduledFrom', 'updatedAt', 'updatedByUid'])
          && isDate(d.date)
          && d.status in ['planned', 'completed', 'missed', 'cancelled']
          && str(d.statusReason, 300)
          && str(d.userNotes, 2000)
          && nullOrDate(d.rescheduledFrom)
          && stampedNow(d)
          // Rest days, the exam and "other" entries are not study tasks.
          && (!(r.type in ['rest', 'exam', 'other']) || d.status == 'planned')
          // The exam date is official and cannot be moved.
          && (r.type != 'exam' || d.date == r.date);
      }

      function validUserSession() {
        let d = request.resource.data;
        let keys = ['date', 'sourceDate', 'startTime', 'endTime', 'timeLabel', 'type', 'title', 'participants', 'topicIds',
                    'optional', 'notes', 'status', 'statusReason', 'userNotes', 'rescheduledFrom', 'imported', 'archived',
                    'createdBy', 'createdAt', 'updatedAt', 'updatedByUid'];
        return d.keys().hasOnly(keys) && d.keys().hasAll(keys)
          && isDate(d.date)
          && d.sourceDate == null
          && d.type in ['individual', 'joint', 'rest', 'buffer', 'practice', 'other']
          && nonEmpty(d.title, 160)
          && d.participants is list && d.participants.size() >= 1 && d.participants.size() <= 2
          && d.participants.hasOnly(profiles())
          && (d.type != 'joint' || d.participants.size() == 2)
          && isTopicList(d.topicIds)
          && d.optional is bool
          && str(d.notes, 2000)
          && (d.timeLabel == null || str(d.timeLabel, 60))
          && isTime(d.startTime) && isTime(d.endTime)
          && (d.startTime == null || d.endTime == null || d.endTime >= d.startTime)
          && d.status in ['planned', 'completed', 'missed', 'cancelled']
          && str(d.statusReason, 300)
          && str(d.userNotes, 2000)
          && nullOrDate(d.rescheduledFrom)
          && d.imported == false && d.archived == false
          && isProfile(d.createdBy)
          && stampedNow(d);
      }

      // ---------------------------------------------------------- discussions
      match /discussions/{discussionId} {
        allow read: if okWs(ws);
        allow create: if okWs(ws) && validNewDiscussion();
        allow update: if okWs(ws) && validDiscussionUpdate();
        allow delete: if false; // use status "deferred" instead
      }

      function validDiscussionFields(d) {
        return nonEmpty(d.title, 160)
          && isTopicList(d.topicIds)
          && d.status in ['open', 'discussed', 'deferred']
          && d.priority in ['normal', 'high']
          && str(d.notes, 2000)
          && (d.sessionId == null || str(d.sessionId, 100));
      }

      function validNewDiscussion() {
        let d = request.resource.data;
        let keys = ['title', 'topicIds', 'raisedBy', 'kind', 'status', 'priority', 'notes', 'sessionId', 'imported',
                    'createdAt', 'updatedAt', 'updatedByUid'];
        return d.keys().hasOnly(keys) && d.keys().hasAll(keys)
          && validDiscussionFields(d)
          && isProfile(d.raisedBy) && d.raisedBy == myProfile()
          && d.kind in ['discuss', 'difficulty', 'revisit', 'question']
          && d.status == 'open'
          && d.imported == false
          && d.createdAt == request.time
          && stampedNow(d);
      }

      function validDiscussionUpdate() {
        let d = request.resource.data;
        return d.diff(resource.data).affectedKeys()
            .hasOnly(['title', 'topicIds', 'status', 'priority', 'notes', 'sessionId', 'updatedAt', 'updatedByUid'])
          && validDiscussionFields(d)
          && stampedNow(d);
      }

      // ---------------------------------------------------------- activity log
      // Append-only, small entries.
      match /activity/{eventId} {
        allow read: if okWs(ws);
        allow create: if okWs(ws) && validActivity();
        allow update, delete: if false;
      }

      function validActivity() {
        let d = request.resource.data;
        let keys = ['type', 'profileId', 'text', 'createdAt', 'byUid'];
        return d.keys().hasOnly(keys) && d.keys().hasAll(keys)
          && d.type in ['progress', 'check', 'session', 'discussion']
          && isProfile(d.profileId) && d.profileId == myProfile()
          && nonEmpty(d.text, 200)
          && d.createdAt == request.time
          && d.byUid == request.auth.uid;
      }
    }
  }
}
